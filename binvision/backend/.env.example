# BinVision backend configuration. Copy to backend/.env and edit.
# Never commit the real .env file.

# AI provider. Currently supported: "gemini". Use "none" to force rule-based/demo mode.
AI_PROVIDER=gemini

# Gemini API key from https://aistudio.google.com/apikey (leave empty to run without AI).
# A free tier may be available, but quotas and billing depend on your Google account.
AI_API_KEY=

# Vision-capable model name. Check Google's current model list if this one is rejected.
AI_MODEL=gemini-2.0-flash

# Seconds to wait for the provider before falling back.
AI_TIMEOUT_SECONDS=20

# Retries after the first attempt for transient errors (bounded; max 2 enforced).
AI_MAX_RETRIES=1

# Maximum upload size in megabytes (frontend enforces the same value: 5).
MAX_UPLOAD_MB=5

# Comma-separated list of allowed browser origins for CORS (dev server by default).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Port uvicorn listens on.
API_PORT=8000
